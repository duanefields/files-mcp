# The mount table lives in a YAML file, not here. See config.example.yaml.
# FILES_MCP_CONFIG=~/.files-mcp/config.yaml

# --- HTTP transport (all optional; stdio is the default) ---
# FILES_MCP_TRANSPORT=http
# FILES_MCP_HOST=127.0.0.1
# FILES_MCP_PORT=18794
# FILES_MCP_STATELESS=true

# --- Authentication, HTTP transport only ---
# FILES_MCP_AUTH=password
# FILES_MCP_PASSWORD=a-long-random-value
# FILES_MCP_BASE_URL=https://files.example.com
# FILES_MCP_STATE_DIR=~/.files-mcp

# --- Monitoring scripts (read from ~/.files-mcp/check.env and update.env) ---
# FILES_MCP_CHECK_ENV=~/.files-mcp/check.env
# FILES_MCP_UPDATE_ENV=~/.files-mcp/update.env
